      "expected": {
        "status": 409,
        "code": "send_in_doubt",
        "delivered": "unknown",
        "state": "unknown",
        "receipt": "unknown"
      }
    },
    {
      "name": "message_node_not_sure",
      "description": "The node says typing stopped part way: the message may have arrived.",
