{
  "version": 1,
  "cases": [
    {
      "name": "number_first_speech_order",
      "kind": "number",
      "description": "First-time numbering assigns s1, s2, s3 by each cluster's earliest start time and preserves turn order.",
      "source": "#17674 Field contract (hub numbering)",
      "input": {
        "raw_turns": [
          [12.0, 18.0, "c2"],
          [2.5, 9.0, "c9"],
          [18.0, 24.0, "c1"],
          [25.0, 30.0, "c9"]
        ]
      },
      "expected": {
        "turns": [
          [12.0, 18.0, "s2"],
          [2.5, 9.0, "s1"],
          [18.0, 24.0, "s3"],
          [25.0, 30.0, "s1"]
        ],
        "next": 4,
        "people": [
          {"id": "s1"},
          {"id": "s2"},
          {"id": "s3"}
        ]
      }
    },
    {
      "name": "pair_overlap_preserves_names_and_allocates_new",
      "kind": "pair",
      "description": "Later timeline pairs clusters with >=50% overlap to existing ids (keeping names) and allocates new ids from next when overlap is below half of both.",
      "source": "#17674 Field contract (pairing a later timeline)",
      "input": {
        "prev_turns": [
          [0.0, 40.0, "s1"],
          [40.0, 70.0, "s2"],
          [70.0, 90.0, "s3"]
        ],
        "next": 4,
        "people": [
          {"id": "s1", "name": "Ada"},
          {"id": "s2", "name": "Grace"},
          {"id": "s3"}
        ],
        "raw_turns": [
          [2.0, 38.0, "c2"],
          [45.0, 65.0, "c1"],
          [82.0, 102.0, "c3"],
          [105.0, 120.0, "c4"]
        ]
      },
      "expected": {
        "turns": [
          [2.0, 38.0, "s1"],
          [45.0, 65.0, "s2"],
          [82.0, 102.0, "s4"],
          [105.0, 120.0, "s5"]
        ],
        "next": 6,
        "people": [
          {"id": "s1", "name": "Ada"},
          {"id": "s2", "name": "Grace"},
          {"id": "s3"},
          {"id": "s4"},
          {"id": "s5"}
        ]
      }
    },
    {
      "name": "pair_one_to_one_largest_overlap_first",
      "kind": "pair",
      "description": "When two new clusters both overlap one old speaker, the larger overlap takes the old id and the smaller gets a new id.",
      "source": "#17674 Field contract (pairing a later timeline)",
      "input": {
        "prev_turns": [
          [0.0, 100.0, "s1"]
        ],
        "next": 2,
        "people": [
          {"id": "s1", "name": "Ada"}
        ],
        "raw_turns": [
          [0.0, 30.0, "c1"],
          [30.0, 90.0, "c2"]
        ]
      },
      "expected": {
        "turns": [
          [0.0, 30.0, "s2"],
          [30.0, 90.0, "s1"]
        ],
        "next": 3,
        "people": [
          {"id": "s1", "name": "Ada"},
          {"id": "s2"}
        ]
      }
    },
    {
      "name": "pair_half_threshold_either_side_qualifies",
      "kind": "pair",
      "description": "An overlap of 50% of the old speaker's speaking time pairs even when it is under 50% of the new cluster's time.",
      "source": "#17674 Field contract (pairing a later timeline)",
      "input": {
        "prev_turns": [
          [0.0, 10.0, "s1"]
        ],
        "next": 2,
        "people": [
          {"id": "s1", "name": "Ada"}
        ],
        "raw_turns": [
          [5.0, 30.0, "c1"]
        ]
      },
      "expected": {
        "turns": [
          [5.0, 30.0, "s1"]
        ],
        "next": 2,
        "people": [
          {"id": "s1", "name": "Ada"}
        ]
      }
    },
    {
      "name": "trim_cuts_turns_past_length",
      "kind": "trim",
      "description": "Shortening a recording clamps turns crossing the new length and drops turns starting at or past it.",
      "source": "#17674 Field contract (shortened recording)",
      "input": {
        "turns": [
          [0.0, 10.0, "s1"],
          [10.0, 25.0, "s2"],
          [20.0, 30.0, "s1"],
          [25.0, 40.0, "s3"]
        ],
        "length": 20.0
      },
      "expected": {
        "turns": [
          [0.0, 10.0, "s1"],
          [10.0, 20.0, "s2"]
        ]
      }
    },
    {
      "name": "align_overlap_70_percent_boundary",
      "kind": "align",
      "description": "Exact 70.0% overlap is unsure; 71.0% overlap (>70%) with >=1s is sure.",
      "source": "#17674 Aligning lines to speakers (rule 3)",
      "input": {
        "turns": [
          [0.0, 7.0, "s1"],
          [7.0, 10.0, "s2"],
          [10.0, 17.1, "s1"],
          [17.1, 20.0, "s2"]
        ],
        "covered": [[0.0, 30.0]],
        "timing": "exact",
        "quality": "ok",
        "next": 3,
        "people": [
          {"id": "s1"},
          {"id": "s2"}
        ],
        "segments": [
          {"start": 0.0, "end": 10.0, "source": "hub", "echo": false, "text": "exact seventy percent split"},
          {"start": 10.0, "end": 20.0, "source": "hub", "echo": false, "text": "above seventy percent split"}
        ]
      },
      "expected": {
        "results": [
          {"over": {"s1": 7.0, "s2": 3.0}, "speaker": "s1", "speaker_unsure": true},
          {"over": {"s1": 7.1, "s2": 2.9}, "speaker": "s1", "speaker_unsure": false}
        ]
      }
    },
    {
      "name": "align_merged_sum_flips_winner_and_certainty",
      "kind": "align",
      "description": "Layer one stores original ids (s1, s2, s4); layer two sums s4 merged_into s1 to 80% and marks s1 sure.",
      "source": "#17674 Aligning lines to speakers (rules 1-3)",
      "input": {
        "turns": [
          [0.0, 4.0, "s1"],
          [4.0, 8.0, "s4"],
          [8.0, 10.0, "s2"]
        ],
        "covered": [[0.0, 20.0]],
        "timing": "turn",
        "quality": "ok",
        "next": 5,
        "people": [
          {"id": "s1", "name": "Ada"},
          {"id": "s2"},
          {"id": "s4", "merged_into": "s1"}
        ],
        "segments": [
          {"start": 0.0, "end": 10.0, "source": "hub", "echo": false, "text": "merged overlap becomes sure"}
        ]
      },
      "expected": {
        "results": [
          {"over": {"s1": 4.0, "s2": 2.0, "s4": 4.0}, "speaker": "s1", "speaker_unsure": false}
        ]
      }
    },
    {
      "name": "align_short_overlap_under_one_second_is_unsure",
      "kind": "align",
      "description": "100% overlap of 0.9 seconds is unsure (<1s); 100% overlap of 1.0 second is sure (>=1s).",
      "source": "#17674 Aligning lines to speakers (rule 3)",
      "input": {
        "turns": [
          [0.0, 0.9, "s1"],
          [5.0, 6.0, "s1"]
        ],
        "covered": [[0.0, 10.0]],
        "timing": "exact",
        "quality": "ok",
        "next": 2,
        "people": [
          {"id": "s1"}
        ],
        "segments": [
          {"start": 0.0, "end": 0.9, "source": "hub", "echo": false, "text": "yes"},
          {"start": 5.0, "end": 6.0, "source": "hub", "echo": false, "text": "right"}
        ]
      },
      "expected": {
        "results": [
          {"over": {"s1": 0.9}, "speaker": "s1", "speaker_unsure": true},
          {"over": {"s1": 1.0}, "speaker": "s1", "speaker_unsure": false}
        ]
      }
    },
    {
      "name": "align_minor_speaker_always_unsure",
      "kind": "align",
      "description": "A minor speaker still labels its transcript line but is always marked unsure.",
