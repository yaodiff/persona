[
  {
    "name": "task_plan",
    "description": "Hand part of your own task to workers: each task you give this starts a new coding agent on a computer, beneath the task you lead, at once, with no card for the user to start it. You get this tool only because your task was handed out as a leader task. Workers belong to this task only: you cannot pick another to-do (todo_id is refused, and every task sets role=worker), a worker cannot hand work on, and at most 8 workers of this task run at a time. A worker that changes files takes the default permission mode unless you set one; a task that only reads sets readonly true and gets the read-only constraint in its first message. Claude-family launchers always start in bypassPermissions mode; Codex read-only tasks keep the plan-mode sandbox. Leave machine and cwd out to start the worker where you run. What a worker reports, and when it stops, stalls or waits for review, reaches you as a message that starts with \"Persona · supervision\"; your own reports still go to whoever handed your task to you. You supervise each worker: give it done_when, and review it with task_review when its supervision message comes. Returns at once, with each worker's to-do; it does not confirm the agent started.\n\nWrite newly generated user-facing arguments, such as titles, reasons, criteria and messages, in English unless the user requests another language or the field requires source wording. Preserve quoted source text, identifiers, tool and parameter names, enum values and command prefixes exactly. Language does not change approval requirements or permission boundaries.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "additionalProperties": false,
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "role",
              "readonly"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "description": "the worker's task in a short line"
              },
              "prompt": {
                "type": "string",
                "description": "the worker's first message: everything it needs to do the work without asking you"
              },
              "role": {
                "type": "string",
                "enum": [
                  "worker"
                ],
                "description": "required: worker; a worker cannot hand work on"
              },
              "machine": {
                "type": "string",
                "description": "machine id; empty: the computer you run on"
              },
              "machine_policy": {
                "type": "string",
                "enum": [
                  "fixed",
                  "flexible"
                ],
                "description": "fixed (default): keep this machine; flexible: a failed launcher health check may move it to another computer"
              },
              "cwd": {
                "type": "string",
                "description": "the project directory: absolute path or ~/…; empty: your own directory when the worker runs on your computer"
              },
              "launcher": {
                "type": "string",
                "description": "launcher name, one that machine has; empty: the default"
              },
              "host": {
                "type": "string",
                "description": "agy (companion) or an enabled engine such as herdr. Overrides the preset host."
              },
              "model": {
                "type": "string",
                "description": "model id; empty: the launcher's default"
              },
              "tier": {
                "type": "string",
                "description": "an Agent preset (a tier of the model profile in use); explicit launcher, model, effort and speed override it"
              },
              "speed": {
                "type": "string",
                "enum": [
                  "standard",
                  "fast",
                  "ultrafast"
                ],
                "description": "new-start speed; explicit choice overrides the tier. standard/omitted: launcher default. Codex: fast, ultrafast; Claude Code: fast only"
              },
              "effort": {
                "type": "string",
                "description": "explicit effort override; omit to use the tier's"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "bypassPermissions",
                  "plan"
                ],
                "description": "empty: the default mode for a writable task. Claude-family launchers always use bypassPermissions; readonly=true adds a first-prompt constraint; Codex keeps plan; TRAE CLI and omp take none"
              },
              "multi_issue_report": {
                "type": "boolean",
                "description": "Only for a report investigating several issues; requires a findings list before park or close."
              },
              "readonly": {
                "type": "boolean",
                "description": "true when the worker only reads (looks things up, reads code, changes no project files); false when it changes files. The first message automatically adds the read-only constraint. Claude-family launchers use bypassPermissions; Codex keeps its plan sandbox"
              },
              "done_when": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                },
                "description": "what done means: results the worker must show, one each; the worker is told them"
              },
              "goal": {
                "type": "string",
                "description": "a read-only worker's goal: what you get from it, in one sentence (a writable worker needs done_when instead); estimates are automatic for both"
              },
              "distinct_from": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "todo_id",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "todo_id": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "description": "required for each open todo whose saved repository issue/PR link this worker references: its todo_id and why this is separate work, kept in the brief"
              },
              "expect_minutes": {
                "type": "integer",
                "minimum": 0,
                "description": "optional minutes override; omit/0 for comparable history or the 60-minute system_default. Review at 1×; stuck at 1.5× (min 20m); overdue at 3× (min 24h)"
              },
              "why": {
                "type": "string",
                "description": "optional: one line on why this machine and directory"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "task_review",
    "description": "Close, send back or hand up one of the worker tasks you handed out with task_plan. You get this tool only as a task leader, and it reaches your own direct workers only (any other task is refused). accepted: the work meets its done_when (you checked the evidence): the task closes. With a nonempty current done_when, accepted requires exactly one check per current criterion, each met=true with nonblank evidence. Missing, duplicate, unknown or unmet checks and blank evidence are refused before any review or completion is written. cancelled and workers without done_when keep their existing behavior. rework: say what is missing (note, or checks that are not met): stalled/low-ROI churn (repeated_error, low_roi_edge, or omitted rework_kind) caps at 2 rounds, while external_input/substantive_new cap at 10 total, after which it goes up as a decision; prefer accepted with a brief note over low-ROI edge cases once core criteria are met. needs_user: only for a decision that is not yours: reason says what to decide and recommend what you would pick; it goes to whoever handed you your task, and nothing is shown to the user from here. cancelled: not to be done: the task closes and its agent is closed. A worker's supervision message tells you when one needs this.\n\nWrite newly generated user-facing arguments, such as titles, reasons, criteria and messages, in English unless the user requests another language or the field requires source wording. Preserve quoted source text, identifiers, tool and parameter names, enum values and command prefixes exactly. Language does not change approval requirements or permission boundaries.",
    "input_schema": {
      "type": "object",
      "required": [
        "todo_id",
        "verdict"
      ],
      "additionalProperties": false,
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "the worker's task id, as the supervision message and task_plan's answer give it"
        },
        "verdict": {
          "type": "string",
          "enum": [
            "accepted",
            "rework",
            "needs_user",
            "cancelled",
            "findings"
          ]
        },
        "findings_review": {
          "type": "object",
          "description": "verdict=findings: omit to read; supply the displayed version to confirm and record dispositions without moving task state.",
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "dispositions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "follow_up_todo_id": {
                    "type": "string",
                    "description": "Independent supervised to-do with the finding’s exact next action in done_when."
                  },
                  "wait_target": {
                    "type": "string",
                    "description": "A single finding may match the park evidence's target."
                  },
                  "done_evidence": {
                    "type": "string",
                    "description": "Evidence that this finding was resolved."
                  },
                  "owner_drop_decision_id": {
                    "type": "string",
                    "description": "Owner's manual decision, question 'Drop investigation finding \u003cid\u003e?', choice 'Drop', with reason."
                  }
                }
              }
            }
          }
        },
        "rework_kind": {
          "type": "string",
          "enum": [
            "external_input",
            "substantive_new",
            "repeated_error",
            "low_roi_edge"
          ],
          "description": "rework, optional: external_input (external review/conflict/owner input; skips 2-round stalled cap), substantive_new (prior gap fixed, new defect found; resets stalled cap), repeated_error/low_roi_edge (default when omitted; cap 2 stalled, 10 total)"
        },
        "note": {
          "type": "string",
          "description": "rework: what is missing, written to the worker; accepted and cancelled: one line of why"
        },
        "checks": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "met"
            ],
            "additionalProperties": false,
            "properties": {
              "criterion": {
                "type": "string",
                "description": "one of the task's done_when"
              },
              "met": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string",
                "description": "what shows it, or what is missing"
              }
            }
          },
          "description": "each done_when with whether it is met, and the evidence"
        },
        "reason": {
          "type": "string",
          "description": "needs_user: one sentence on what is to be decided"
        },
        "recommend": {
          "type": "string",
          "description": "needs_user: the option you recommend"
        }
      }
    }
  }
]