[
  {
    "name": "resource_status",
    "description": "读取共享门禁、排队票号、重复标记和镜像时效。未知或过期不代表运行成功。",
    "input_schema": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        }
      },
      "required": []
    },
    "defer_loading": true
  },
  {
    "name": "ask_user",
    "description": "Ask multiple-choice questions with explicit decision rights. Use decision_scope=internal for execution choices or recommendations: a designated supervisor is woken and answers as the assistant. Owner decisions require why_owner or owner_action. For a personal unlock, use owner_action=personal_unlock and let the owner act in their own app; never request a password or private key. Owners can also type an answer. Default wait=true holds this turn; a user message withdraws a waiting question, and a queued message can release the turn after two minutes. With wait=false, return at once, end the turn without guessing, and receive one later receipt with the answer, cancellation or expiry, including after restart. Questions wait up to two hours, or until deadline. An unanswered internal question authorizes nothing. Owner deadline defaults require reversible=true and recommend on every question; outward, spending, personal and irreversible actions never take a default.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "decision_scope": {
          "type": "string",
          "enum": [
            "internal",
            "owner"
          ],
          "description": "Internal execution questions go to a supervisor. Owner questions require why_owner or owner_action. Omitting all decision-right metadata is rejected."
        },
        "why_owner": {
          "type": "string",
          "enum": [
            "priority",
            "acceptance",
            "only_owner_knows",
            "visible_to_others",
            "irreversible"
          ],
          "description": "Why this decision requires the owner; omit for internal execution questions"
        },
        "owner_action": {
          "type": "string",
          "enum": [
            "personal_unlock",
            "login",
            "second_factor",
            "experience_check",
            "spending"
          ],
          "description": "An action only the owner can perform; never include credentials"
        },
        "wait": {
          "type": "boolean",
          "description": "default true: hold this turn until the user answers. false: put the card up and return at once; the answer arrives later as a new message in this conversation"
        },
        "deadline": {
          "type": "string",
          "description": "optional: until when the questions wait, a duration (\"30m\", \"4h\") or an RFC 3339 time, 1 minute to 30 days ahead; needs reversible and a recommend on every question"
        },
        "reversible": {
          "type": "boolean",
          "description": "with deadline: whether going ahead with the recommended options can be undone later. false for deleting, sending anything to other people, spending money or changing production: those are never taken by default"
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "recommend": {
                "type": "string",
                "description": "the label of the option you recommend; required with deadline"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "ask_user_withdraw",
    "description": "Withdraw a pending `ask_user` card of this conversation. Other chats' cards and user-owned approvals/plans/dialogs are rejected; already-ended own cards are idempotent.",
    "input_schema": {
      "type": "object",
      "required": [
        "interaction_id"
      ],
      "properties": {
        "interaction_id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "notify_user",
    "description": "Send the user a push notification right now (works when the app is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; ordinary replies already notify. In the hub's push grading, a notice from a conversation other than the main one is held for the briefing instead of alerting unless it is P0; the tool answer then says it was moved to the briefing, so treat the user as not alerted.",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "push_level": {
          "type": "string",
          "enum": [
            "P0",
            "P1"
          ],
          "description": "How urgent this is. P1 (default): worth knowing; in the hub's push grading it is held for the briefing instead of alerting, and from a non-main conversation it is held even without an explicit level. P0: something the user must do or decide themselves (an action only they can take, a decision only they can make), so it alerts even in push grading and from any conversation. Use P1 for results, progress and conclusions."
        },
        "related_key": {
          "type": "string",
          "description": "Optional: what this is about, such as a PR link or a to-do id. In push grading the same key interrupts at most once in 12 hours, and held notices about it are listed together."
        }
      }
    }
  },
  {
    "name": "supervision_finish",
    "description": "Finish handling a supervision wake-up without cluttering the user's main conversation. Use visibility=\"silent\" when no user decision or useful result needs to be shown, with a short summary of what you checked or changed; then end the turn. The complete turn stays available in the expandable supervision record. Use visibility=\"user\" to explicitly show the turn without sending a notification. notify_user, ask_user, and task_review user conclusion cards also promote the turn. A promoted turn cannot be made silent again. This tool is only for supervision-triggered turns, not normal user messages.",
    "input_schema": {
      "type": "object",
      "required": [
        "visibility",
        "summary"
      ],
      "properties": {
        "visibility": {
          "type": "string",
          "enum": [
            "silent",
            "user"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "schedule_followup",
    "description": "Wake yourself later with `prompt`; `new_conversation: true` uses its own chat. Wakes reset the message hop chain at most once per 10 minutes. `at` accepts RFC3339 or relative 30m/2h/1d. For repeats set `every` (5m-7d) once; never chain runs. Or use `cron` instead of at/every: 5 fields in the user's zone, at least 5m apart; @hourly/@daily/@weekly/@monthly/@yearly work. Day 0/7 is Sunday; restricted day fields match either. Inspect the reply's next runs. `until` cannot be a bare clock time.\n\nRuns inherit Main chat's launcher/model/effort; overrides require an own conversation, and permission mode stays the user's choice. `inbox` is only for requested Inbox results. `fresh_each_run: true` starts a new chat each run with its state note. See field descriptions for push and end-time edit rules.\n\nFor approved recurring work advancing a supervised to-do, pass its explicit `todo_id`; do not guess from a title. Omission keeps an association; \"\" clears it; one-shots refuse it. From the second run, progress is new Agent answers or tool calls (not waits or repeats), criterion changes or progress reports; a long stall asks Change approach / Keep waiting, even with `push: asked`. Get owner consent before creating or changing recurring work.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "explicit supervised to-do this recurring follow-up advances"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "description": "when (the first run, with every); default with every: one interval from now"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "cron": {
          "type": "string",
          "description": "repeat on a cron expression instead of at / every: minute hour day-of-month month day-of-week in the user's time zone, e.g. */30 9-18 * * 1-5"
        },
        "prompt": {
          "type": "string",
          "description": "what to do then, self-contained"
        },
        "title": {
          "type": "string",
          "description": "short label shown in the app"
        },
        "new_conversation": {
          "type": "boolean",
          "description": "start a fresh conversation instead of continuing this one"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something or a standing loop (a patrol, a daily round). Continuing this conversation, a run's answer is then not pushed or sent to channels; from Main chat it runs in its own conversation instead. Omit to keep an existing task's"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "what of a run goes into the user's Inbox, independent of push: off (default for a new task), worthy (a run puts a row there with inbox_post only when it finds something worth a look), every (every run ends with a row made by Persona). Set it only when the user asked for it. Omit to keep an existing task's"
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "optional end time (RFC 3339 or 30m / 2h / 1d). After it, Persona turns the task off and records a skipped run instead of running. Omit to keep an existing task's end time; null clears it. Ignored for a one-off."
        },
        "launcher": {
          "type": "string",
          "description": "this task's own launcher, instead of Main chat's (a name on the computer where its runs start). Needs new_conversation: true: a follow-up that continues this conversation runs on that conversation's launcher. Empty clears the override and follows Main chat again. Omit to keep an existing task's"
        },
        "model": {
          "type": "string",
          "description": "model id for the launcher above; without a launcher it pins the launcher the task runs on now. Empty uses the launcher's default. Omit to keep an existing task's"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "thinking effort for Claude launchers; without a launcher it pins the launcher the task runs on now. Omit to keep an existing task's; empty clears it"
        }
      }
    }
  },
  {
    "name": "schedule_routine",
    "description": "Create a recurring routine, or pass `id` from list_followups to edit supplied fields. `enabled: false` pauses it. Use `time` (with optional `weekdays`) or 5-field `cron` in the user's zone (at least 5m apart; aliases, 0/7=Sun, Vixie day OR; no seconds/@every/TZ=; check reply's next runs). `until` needs RFC 3339 or relative duration.\n\nRuns inherit Main chat's launcher/model/effort (omit to keep; empty launcher resets). Permission mode is the user's. `fresh_each_run: true` starts a new chat per run with its state note. For a supervised to-do, pass `todo_id` (omit keeps; \"\" clears; Persona checks real progress from run 2 and asks on stalls). For a dashboard page you write, pass `page_id` (one routine/page, immutable, \u003e=60m apart, never pushes or posts to Inbox, no report/todo_id; held on draft until Keep, data-only grant on kept page). Get owner consent before creating or changing recurring work.",
    "input_schema": {
      "type": "object",
      "properties": {
        "todo_id": {
          "type": "string",
          "description": "supervised to-do this routine advances"
        },
        "page_id": {
          "type": "string",
          "description": "pg_ dashboard page to refresh (immutable, \u003c=1/hour, no push/inbox/report/todo_id)"
        },
        "fresh_each_run": {
          "type": "boolean"
        },
        "id": {
          "type": "string",
          "description": "existing routine id to edit"
        },
        "title": {
          "type": "string",
          "description": "short name shown in the app, e.g. 早报"
        },
        "prompt": {
          "type": "string",
          "description": "self-contained instructions for each run"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1=Mon…7=Sun; omit/empty = every day"
        },
        "cron": {
          "type": "string",
          "description": "replaces time/weekdays: 5 fields in user's zone (e.g. */30 9-18 * * 1-5) or @hourly/@daily/@weekly/@monthly/@yearly"
        },
        "enabled": {
          "type": "boolean"
        },
        "report": {
          "type": "boolean",
          "description": "daily report: prepends Persona's north-star lines. Omit to keep"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default): push every answer; asked: only notify_user (own chat). Omit to keep"
        },
        "inbox": {
          "type": "string",
          "enum": [
            "off",
            "worthy",
            "every"
          ],
          "description": "Inbox rows (only when requested): off (default), worthy (inbox_post), every. Omit to keep"
        },
        "run_if": {
          "type": [
            "object",
            "null"
          ],
          "description": "owner-approved pre-run shell check (exit 0 runs, 1 skips; null removes; omit keeps)",
          "properties": {
            "command": {
              "type": "string",
              "maxLength": 4096
            },
            "timeout_s": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 30
            },
            "on_error": {
              "type": "string",
              "enum": [
                "run",
                "skip"
              ],
              "default": "run"
            }
          },
          "required": [
            "command"
          ],
          "additionalProperties": false
        },
        "until": {
          "type": [
            "string",
            "null"
          ],
          "description": "end time (RFC 3339 or 30m/2h/1d); null clears, omit keeps"
        },
        "launcher": {
          "type": "string",
          "description": "launcher override; empty resets to Main chat; omit keeps"
        },
        "model": {
          "type": "string",
          "description": "model id for launcher; empty uses launcher default; omit keeps"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Claude thinking effort; omit keeps"
        }
      }
    }
  },
  {
    "name": "schedule_state_set",
    "description": "Stage the recurring task's state note for this scheduled run. Call near the end of the run with the run key in the scheduled prompt and the full replacement state (up to 4096 UTF-8 bytes). Keep cursors, references, and what was already reported. The hub attempts to save the draft after confirming that the run succeeded. If it cannot track the run or write the note, later runs use the last saved note. An empty string clears the note when saved.",
    "input_schema": {
      "type": "object",
      "required": [
        "run_key",
        "text"
      ],
      "properties": {
        "run_key": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "list_followups",
    "description": "List every scheduled task (with ids): follow-ups that have not run yet, repeating ones, daily routines. A repeating task with an end time shows that time.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_places",
    "description": "The user's saved places (home, the office, …) with their coordinates and reminder radius, as the user set them in Settings › Assistant › Saved Places or as you saved them with save_place. Read them before a reminder by place, and before a route or directions to or from a place the user names (home, the office); never take a place's coordinates from memory.",
    "input_schema": {
      "type": "object",
      "properties": {}
    },
    "defer_loading": true
  },
  {
    "name": "save_place",
    "description": "Save a place to the user's saved places, or change the saved place of the same name. Only for a place the user just confirmed in this conversation (their current location while they are there, or a phone_location_search result they picked); the user sees and edits it in Settings › Assistant › Saved Places.",
    "input_schema": {
      "type": "object",
      "required": [
        "name",
        "latitude",
        "longitude"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "What the user calls it, e.g. 家 or 公司 (at most 40 characters)"
        },
        "address": {
          "type": "string",
          "description": "The address, as phone_location_search gave it"
        },
        "latitude": {
          "type": "number"
        },
        "longitude": {
          "type": "number"
        },
        "radius_meters": {
          "type": "integer",
          "description": "The reminder circle, 100–2000; leave it out for 150"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "machines_list",
    "description": "List computers' connection, system, resources, agents, launcher failures and node builds. Samples over 30 seconds old are stale. Nulls have reasons; do not infer or rank.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "machine_redeploy",
    "description": "Redeploy by ID or exact name; return the confirmed outcome.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine"
      ],
      "properties": {
        "machine": {
          "type": "string"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "agents_list",
    "description": "The Claude Code / Codex agents running on the user's computers (herdr), with their state: needs_you (waiting for an answer / approval), working, unread (finished, result not looked at), idle. done lists work finished in the last 24 hours, and muted lists the muted agents that would otherwise appear in the live snapshot; both include the work conclusion when known. Each line has machine, session id, project, title, last update and the last thing the agent said. launcher= names the launcher an agent runs on when it is known, and usage_limit (with resets_at when the reset is known) marks one its subscription's usage limit stopped (agent_switch moves such an agent to another launcher when the user asks). Known Claude Code switch states appear as ultracode=on/off; an omitted state is unknown. ultracode=on means every substantive task runs a multi-agent dynamic workflow, independently of thinking effort. Let it finish and wait for workflow results without nudging it. Much faster and more accurate than ssh + herdr. At the end: the launchers that failed their last health check, by machine (agent_start and task_plan move off them).\n\nA line under an agent is something waiting for the user: a question lists its options and the interaction id to answer it with (interaction_answer), an approval is the user's to give in the app.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "done",
            "muted",
            "archived",
            "all"
          ],
          "description": "default active = needs_you + working + unread; done = finished work in the last 24 hours; muted = muted agents in the live snapshot categories; archived: only the archived sessions (agent_unarchive restores them); the others leave archived ones out, all lists them marked archived"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10). Use it to answer the user's follow-ups about work an agent or task already did (its conclusion, a PR link, why it stopped) instead of asking the agent with agent_send, which makes it take another turn while the user waits (and a stopped agent takes no messages: it is read-only).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send the user's request. Busy Agents may queue it. To keep context after a stop, use resume and resume_why, including for unknown stops. User or exit stops need the owner's Resume. Give task unless the Agent has your open task. Nearly full Agents compact first. Use agent_start for unrelated work, ask_user if unsure. An unused branch starts on first send. Only /exit or /quit stops an Agent and keeps its tab. The owner closes other chats' Agents.\n\nFor dialog_open, retry with dismiss_notice only when Enter alone closes the notice. For permissions and pickers, tell the user or use interaction_answer.\n\nGive task to supervise new work, including done_when in text. More on your existing task keeps its title and updates its criteria. A different title, the user's own to-do or another conversation's task is refused. A failed send creates no task. Omit task or use null for a reply, nudge or decision. Blank fields count as omitted.\n\nUse `handoff` for your stopped to-do. A node ack starts its result wait. Resume a stopped Agent onto its own open to-do with `todo_id` (never `task`).\n\n`wait_seconds` observes up to 50s after dispatch. `Inline observation` JSON: `completed` (this input's `reply`), `question` (pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, known input/session ids. It never answers questions, accepts tasks, resends or cancels work. Normal supervision via `task_review` applies. Older nodes may time out rather than return an unrelated reply.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "wait_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "0/omitted: normal receipt"
        },
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "inbox_item": {
          "type": "string",
          "description": "Inbox ID to link to the task. Omit to skip linking."
        },
        "resume": {
          "type": "boolean",
          "description": "resume this stopped agent with its context, text as its first message"
        },
        "resume_why": {
          "type": "string",
          "description": "shown to the user"
        },
        "todo_id": {
          "type": "string",
          "description": "with resume: the stopped Agent's open unassigned to-do to re-link; omit for task adoption"
        },
        "dismiss_notice": {
          "type": "boolean",
          "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
        },
        "attachments": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string"
          },
          "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
        },
        "handoff": {
          "type": "object",
          "required": [
            "todo_id",
            "receiving_todo_id",
            "head",
            "check",
            "until"
          ],
          "additionalProperties": false,
          "properties": {
            "todo_id": {
              "type": "string"
            },
            "receiving_todo_id": {
              "type": "string"
            },
            "head": {
              "type": "string",
              "description": "Full candidate commit ID"
            },
            "check": {
              "type": "string"
            },
            "until": {
              "type": "string",
              "description": "Duration or RFC 3339 deadline"
            }
          }
        },
        "task": {
          "type": [
