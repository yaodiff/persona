          "description": "the agent's exact full session id, never a prefix"
        },
        "since": {
          "type": "string",
          "format": "date-time",
          "description": "inclusive RFC3339 start of the original confirmation window; requires before"
        },
        "before": {
          "type": "string",
          "format": "date-time",
          "description": "exclusive RFC3339 end of the original confirmation window [since,before); at most 24 hours after since"
        }
      }
    },
    "defer_loading": true
  },
  {
    "name": "interaction_answer",
    "description": "Answer a card handed to you as supervisor or internal reviewer. Use exact machine/session_id/interaction_id from the wake-up; maintenance session_id may be empty. Internal cards may belong to assistant chats; never answer your own. Questions use offered labels (arrays for multi-select), terminal dialogs use labels/numbers, permissions/plans use allow and reason. The answer is the assistant's and becomes a task decision. Secrets/forms, outward messages, spending, irreversible and trust/Bypass approvals need the owner (ask_escalate for task cards). Other assistant cards stay unavailable.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "interaction_id"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "interaction_id": {
          "type": "string",
