{
  "name": "decisions_query",
  "description": "memory[] full scan: tag ranks all-term matches first, backfilling partial/rank hits. by/trust/non-active: memory_omitted=ledger_filters; retry tag alone. scope=ledger-only",
  "input_schema": {
    "type": "object",
    "properties": {
      "after": {
        "type": "string"
      },
      "limit": {
        "type": "integer"
      },
      "by": {
        "type": "string"
      },
      "trust": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "tag": {
        "type": "string"
      },
      "scope": {
        "type": "object"
      }
    },
    "additionalProperties": false
  }
}
