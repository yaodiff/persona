{
  "name": "message_send",
  "description": "Send Lark text (default bot), not via CLI/ask_user. Use a revocable channel/chat/scenario/identity grant or owner approval. Repository grants do not apply. If bot cannot send, report it without changing identity. Reuse idempotency_key on retries. Check destination after uncertain delivery. Other approvals stay.",
  "input_schema": {
    "type": "object",
    "properties": {
      "channel": {
        "type": "string",
        "enum": [
          "larkcli"
        ]
      },
      "target": {
        "type": "string",
        "description": "oc_ chat ID; resolve read-only."
      },
      "text": {
        "type": "string",
        "minLength": 1,
        "description": "Maximum 16000 UTF-8 bytes."
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "required": [
      "channel",
      "target",
      "text",
      "idempotency_key"
    ],
    "additionalProperties": false
  }
}
