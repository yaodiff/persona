{
  "name": "agent_send",
  "description": "Send the user's request. Busy Agents may queue it. To keep context after a stop, use resume and resume_why, including for unknown stops. User or exit stops need the owner's Resume. Give task unless the Agent has your open task. Nearly full Agents compact first. Use agent_start for unrelated work, ask_user if unsure. An unused branch starts on first send. Only /exit or /quit stops an Agent and keeps its tab. The owner closes other chats' Agents.\n\nFor dialog_open, retry with dismiss_notice only when Enter alone closes the notice. For permissions and pickers, tell the user or use interaction_answer.\n\nGive task to supervise new work, including done_when in text. More on your existing task keeps its title and updates its criteria. A different title, the user's own to-do or another conversation's task is refused. A failed send creates no task. Omit task or use null for a reply, nudge or decision. Blank fields count as omitted.\n\nUse `handoff` for your stopped to-do. A node ack starts its result wait. Resume a stopped Agent onto its own open to-do with `todo_id` (never `task`).\n\n`wait_seconds` observes up to 50s after dispatch. `Inline observation` JSON: `completed` (this input's `reply`), `question` (pending `interaction_id`), `timeout`/`cancelled`/`unavailable`/`interrupted`/`failed`, known input/session ids. It never answers questions, accepts tasks, resends or cancels work. Normal supervision via `task_review` applies. Older nodes may time out rather than return an unrelated reply.",
  "input_schema": {
    "type": "object",
    "required": [
      "machine",
      "session_id",
      "text"
    ],
    "properties": {
      "wait_seconds": {
        "type": "integer",
        "minimum": 0,
        "description": "0/omitted: normal receipt"
      },
      "machine": {
        "type": "string"
      },
      "session_id": {
        "type": "string"
      },
      "text": {
        "type": "string"
      },
      "inbox_item": {
        "type": "string",
        "description": "Inbox ID to link to the task. Omit to skip linking."
      },
      "resume": {
        "type": "boolean",
        "description": "resume this stopped agent with its context, text as its first message"
      },
      "resume_why": {
        "type": "string",
        "description": "shown to the user"
      },
      "todo_id": {
        "type": "string",
        "description": "with resume: the stopped Agent's open unassigned to-do to re-link; omit for task adoption"
      },
      "dismiss_notice": {
        "type": "boolean",
        "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
      },
      "attachments": {
        "type": "array",
        "maxItems": 8,
        "items": {
          "type": "string"
        },
        "description": "absolute paths of pictures/files the user gave in this conversation (Claude Code path or app attachment); copied to the agent, appended to its message with mentions updated; others refused"
      },
      "handoff": {
        "type": "object",
        "required": [
          "todo_id",
          "receiving_todo_id",
          "head",
          "check",
          "until"
        ],
        "additionalProperties": false,
        "properties": {
          "todo_id": {
            "type": "string"
          },
          "receiving_todo_id": {
            "type": "string"
          },
          "head": {
            "type": "string",
            "description": "Full candidate commit ID"
          },
          "check": {
            "type": "string"
          },
          "until": {
            "type": "string",
            "description": "Duration or RFC 3339 deadline"
          }
        }
      },
      "task": {
        "type": [
          "object",
          "null"
        ],
        "description": "new work: make it your supervised task first (main or a lead); null for a reply",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "description": "the task in a short line (Chinese, under 20 characters)"
          },
          "done_when": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            },
            "description": "results you can check when it says it is done (a PR merged, a sheet's link, what the live system answers)"
          },
          "expect_minutes": {
            "type": "integer",
            "description": "how long it should take from now; longer without progress counts as stuck"
          }
        }
      }
    }
  }
}
